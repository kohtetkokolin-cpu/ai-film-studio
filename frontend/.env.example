# Public Supabase values only. Never put service-role or Gemini keys in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Optional only for local development when backend is running separately:
VITE_API_BASE_URL=http://127.0.0.1:8000
